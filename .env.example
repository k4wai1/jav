# jev-android-mcp — plantilla de entorno.
# COPIAR a `.env` (chmod 600) y rellenar. NUNCA commitear el `.env` real.

# --- Transporte MCP → app Android (Fase 4+) ---
# Loopback vía adb forward:
JEV_WS_URL=ws://127.0.0.1:38472/
# Remoto vía tailnet (opt-in, WSS + pinning):
# JEV_WS_URL=wss://100.64.x.x:38472/
# Fingerprint SHA-256 del cert self-signed (sale del QR de onboarding):
JEV_CERT_FINGERPRINT=
# Token bearer de la app (sale del QR de onboarding):
JEV_TOKEN=

# --- Jev vía OpenRouter (defecto; probado en Mango-mcp) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=typesafe/jev-1.13

# --- Jev vía API oficial TypeSafe (swap futuro) ---
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_MODEL=jev-latest
GLM_MODEL=z-ai/glm-5.3-flash

# --- S2 conmutable: openrouter (default) | deepseek ---
# Default openrouter para no romper nada; con deepseek usa DEEPSEEK_API_KEY.
S2_PROVIDER=openrouter
# --- S2 vía DeepSeek (opt-in del operador; misma forma que OpenRouter) ---
DEEPSEEK_API_KEY=
S2_DEEPSEEK_MODEL=deepseek-chat
# Tarifas DeepSeek USD por MTok (PLACEHOLDER ajustable contra factura,
# nunca verdad oficial hardcodeada):
DEEPSEEK_RATE_IN=0.27
DEEPSEEK_RATE_OUT=1.10
