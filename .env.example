# jev-android-mcp — plantilla de entorno.
# COPIAR a `.env` (chmod 600) y rellenar. NUNCA commitear el `.env` real.

# --- Transporte MCP → app Android (Fase 4+) ---
# Loopback vía adb forward:
JEV_WS_URL=ws://127.0.0.1:38472/
# Remoto vía tailnet (opt-in, WSS + pinning):
# JEV_WS_URL=wss://100.64.x.x:38472/
# Fingerprint SHA-256 del cert self-signed (sale del QR de onboarding):
JEV_CERT_FINGERPRINT=
# Token bearer de la app (sale del QR de onboarding):
JEV_TOKEN=

# --- Jev vía OpenRouter (defecto; probado en Mango-mcp) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=typesafe/jev-1.13

# --- Jev vía API oficial TypeSafe (swap futuro) ---
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_MODEL=jev-latest

# --- S2 agnóstico OpenAI-compatible (spec docs/specs/ai-providers.md §2) ---
# S2 habla POST {base}/chat/completions. Cualquier servidor con ese shape
# sirve (OpenRouter, OpenAI-direct, DeepSeek-direct, Ollama/vLLM local,
# Termux-local). S2 nunca toca el dispositivo. S1 NUNCA lee JAV_AI_*.
# Base (default OpenRouter):
# JAV_AI_BASE_URL=https://openrouter.ai/api/v1
# Key S2 (opcional; orden: JAV_AI_API_KEY → OPENROUTER_API_KEY → ninguna):
# sin ninguna key contra base local loopback → permitido sin auth;
# sin ninguna key contra base remota → error honesto, nunca stub.
# JAV_AI_API_KEY=
# Modelo S2 (cadena JAV_AI_MODEL → S2_MODEL → GLM_MODEL → default):
# JAV_AI_MODEL=
# Retrocompat (sigue mandando si JAV_AI_MODEL está vacío; S2_MODEL gana):
S2_MODEL=z-ai/glm-5.3-flash
# Si quieres DeepSeek vía OpenRouter con la misma key (sin keys nuevas): S2_MODEL=deepseek/deepseek-chat
# Vía OpenAI-direct (ejemplo): JAV_AI_BASE_URL=https://api.openai.com/v1 + JAV_AI_MODEL=gpt-4o-mini + JAV_AI_API_KEY=<key>
# Vía local Ollama sin auth (solo loopback): JAV_AI_BASE_URL=http://127.0.0.1:11434/v1 + JAV_AI_MODEL=<modelo-local>

# --- Jav (servidor Go MCP stdio; cmd/jav) ---
# Transporte MCP → Jam (JAV_* manda; JEV_WS_URL/JEV_TOKEN valen como fallback):
JAV_WS_URL=ws://127.0.0.1:38472/
# Remoto opt-in (WSS obligatorio fuera de loopback):
# JAV_WS_URL=wss://100.64.x.x:38472/
JAV_TOKEN=
# S1 (default typesafe/jev-1.13):
JEV_MODEL=typesafe/jev-1.13
# Tasas S2 (placeholder ajustable contra factura, nunca oficial):
# GLM_RATE_IN=0.15
# GLM_RATE_OUT=0.50
# Overrides S1 (defaults 0.042 / 0.0):
# JEV_RATE_IN=0.042
# JEV_RATE_OUT=0.0
# Forense del director (lo escribe el cliente, no el servidor):
JAV_LOG_DIR=logs/
