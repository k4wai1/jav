# jev-android-mcp — plantilla de entorno.
# COPIAR a `.env` (chmod 600) y rellenar. NUNCA commitear el `.env` real.

# --- Transporte MCP → app Android (Fase 4+) ---
# Loopback vía adb forward:
JEV_WS_URL=ws://127.0.0.1:38472/
# Remoto vía tailnet (opt-in, WSS + pinning):
# JEV_WS_URL=wss://100.64.x.x:38472/
# Fingerprint SHA-256 del cert self-signed (sale del QR de onboarding):
JEV_CERT_FINGERPRINT=
# Token bearer de la app (sale del QR de onboarding):
JEV_TOKEN=

# --- Jev vía OpenRouter (defecto; probado en Mango-mcp) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=typesafe/jev-1.13

# --- Jev vía API oficial TypeSafe (swap futuro) ---
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_MODEL=jev-latest

# --- S2 vía OpenRouter (único provider; misma OPENROUTER_API_KEY que S1) ---
# Modelo S2 por env (S2_MODEL manda; GLM_MODEL vale como alias).
S2_MODEL=z-ai/glm-5.3-flash
# Si quieres DeepSeek, usa el slug OpenRouter con la misma key (sin keys nuevas): S2_MODEL=deepseek/deepseek-chat

# --- Jav (servidor Go MCP stdio; cmd/jav) ---
# Transporte MCP → Jam (JAV_* manda; JEV_WS_URL/JEV_TOKEN valen como fallback):
JAV_WS_URL=ws://127.0.0.1:38472/
# Remoto opt-in (WSS obligatorio fuera de loopback):
# JAV_WS_URL=wss://100.64.x.x:38472/
JAV_TOKEN=
# S1 (default typesafe/jev-1.13):
JEV_MODEL=typesafe/jev-1.13
# Tasas S2 (placeholder ajustable contra factura, nunca oficial):
# GLM_RATE_IN=0.15
# GLM_RATE_OUT=0.50
# Overrides S1 (defaults 0.042 / 0.0):
# JEV_RATE_IN=0.042
# JEV_RATE_OUT=0.0
# Forense del director (lo escribe el cliente, no el servidor):
JAV_LOG_DIR=logs/
