# jev-android-mcp — nunca commitear credenciales ni artefactos locales.
# Regla: si lleva secreto, va en .env (ignorado) y su forma en .env.example.

# --- Secretos ---
.env
*.env
!.env.example
*.jks
*.keystore
*.p12
# Excepción v1.2.5: debug.keystore determinista (clave debug estándar AOSP,
# no es secreto) para que local y CI firmen igual (install -r in-place).
!android-app/app/debug.keystore
google-services.json

# --- Android / Gradle (máquina-específico y artefactos) ---
local.properties
.gradle/
build/
app/build/
*.apk
*.aab
*.ap_

# --- Python / MCP server (Fase 4+) ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# --- Logs y temporales ---
logs/
*.log
tmp/
temp/

# --- Go / Jav MCP (binarios; solo fuentes en git) ---
dist/
*.exe

# --- OS / editores ---
.DS_Store
Thumbs.db
.idea/
*.iml
.vscode/
*~
refs/

# --- Paquete de auditoría externa (skill audit-bundle; artefactos generados) ---
/jav-audit.zip
/jav-audit.txt
/jav-tree.txt
/jav_context.txt

# --- OpenCode: node_modules sí es local; las skills SÍ se commitean ---
# (antes se ignoraba .opencode/skills/; la skill audit-bundle es parte del repo)
